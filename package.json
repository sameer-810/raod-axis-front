{
  "name": "roadaxis-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "shots:public": "node scripts/audit-shots.mjs",
    "shots:console": "node scripts/console-shots.mjs",
    "pdf:client": "node scripts/render-pdf.mjs ui-presentation.html RoadAxis-Interface.pdf",
    "pdf:audit": "node scripts/render-pdf.mjs ui-audit.html RoadAxis-UI-Audit.pdf",
    "pdf:whatsapp": "node scripts/render-pdf.mjs whatsapp-setup-guide.html RoadAxis-WhatsApp-Setup-Guide.pdf",
    "docs:client": "npm run shots:public && npm run shots:console && npm run pdf:client",
    "validate": "npm run lint && npm run format",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.96.1",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.8.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.8"
  }
}
