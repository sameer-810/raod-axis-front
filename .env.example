VITE_API_BASE_URL=http://localhost:5005/api

# "metric" | "imperial".
# The client's own filter is written in metres and kilometres ("nearby 500m -
# 2km"), so metric is the default. UK drivers think in miles, so this is a
# one-line switch rather than a code hunt. See DECISIONS.md D-002.
VITE_DISTANCE_UNIT=metric

# Public site origin, used for canonical URLs and share links.
VITE_PUBLIC_URL=http://localhost:5175
