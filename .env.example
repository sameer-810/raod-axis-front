VITE_API_BASE_URL=http://localhost:5005/api

# "metric" | "imperial".
# The client's own filter is written in metres and kilometres ("nearby 500m -
# 2km"), so metric is the default. UK drivers think in miles, so this is a
# one-line switch rather than a code hunt. See DECISIONS.md D-002.
VITE_DISTANCE_UNIT=metric

# Public site origin, used for canonical URLs and share links.
VITE_PUBLIC_URL=http://localhost:5175

# ── Map tiles ────────────────────────────────────────────────────────────────
# Defaults to OpenStreetMap's own tiles, which need no key and look right.
#
# Their usage policy covers modest traffic only and explicitly excludes a busy
# commercial product, so set these before launch. MapTiler, CARTO and
# Thunderforest all sell a key for a few pounds a month; CARTO's keyless tiles
# are now stamped "API KEY REQUIRED" across every image, so do not point at
# those without one.
#
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
